#!/usr/bin/env bash
set -euo pipefail

STREAMING_HOST="${STREAMING_HOST:-streaming.railway.internal}"

sed "s/__STREAMING_HOST__/${STREAMING_HOST}/g" \
  /opt/mastodon/config/nginx.railway.conf.template \
  > /tmp/nginx.railway.conf

rm -f /opt/mastodon/tmp/pids/server.pid

bundle exec rails s -b 127.0.0.1 -p 3001 &
rails_pid=$!

cleanup() {
  kill -TERM "${rails_pid}" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

exec nginx -c /tmp/nginx.railway.conf -g 'daemon off;'
